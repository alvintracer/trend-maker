# Supabase + Prisma:
# - DATABASE_URL: transaction-mode pooler (runtime)
# - DIRECT_URL: session-mode pooler or direct connection (schema sync / migrations)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=trend_maker"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?schema=trend_maker"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4"

# Optional: disable browser-based crawler fallback in serverless environments.
DISABLE_BROWSER_CRAWL="false"

# Optional: local-only FMKorea browser fallback override.
FMKOREA_CHROME_EXECUTABLE=""
